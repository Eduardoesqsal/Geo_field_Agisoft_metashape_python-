# Copia este archivo a .env.receiver.local y completa los valores en esta PC.
# No incluyas comillas. Nunca guardes valores reales en Git.
GEOFIELD_API_BASE_URL=
GEOFIELD_SUPABASE_URL=
GEOFIELD_SUPABASE_ANON_KEY=
GEOFIELD_WORKER_EMAIL=
GEOFIELD_WORKER_PASSWORD=

# Dejar vacio: con Supabase el receptor obtiene el token automaticamente.
GEOFIELD_ACCESS_TOKEN=
GEOFIELD_POLL_SECONDS=30
